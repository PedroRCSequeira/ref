            if abs(val - best_val) < 1e-6:
                g_cells.append(f"{BG_BEST}{raw_g}{C_RESET}")
            else:
                g_cells.append(f"{row_bg}{raw_g}{C_RESET}")
            
        g_vals = " | ".join(g_cells)

        print(f"{p_vals} | {g_vals}")

    print(divider_str + "\n")

    # --------------------------------------------------------------------------
